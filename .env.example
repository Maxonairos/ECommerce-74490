# Copiá este archivo como .env.local para usar tu propio proyecto de Firebase.
# Si no se definen, la aplicación usa la configuración pública incluida en src/db/db.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL del backend de Mercado Pago (proyecto MP-NodeJS/mp).
# Si está vacía, el checkout guarda la orden pero no inicia el pago.
VITE_MP_API_URL=
